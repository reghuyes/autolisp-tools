  "extraction_patterns": {
    "User Name": "(?im)^\\s*(?:user\\s*name|username)\\s*[:\\-]\\s*(.+?)\\s*$",
    "Password": "(?im)^\\s*(?:password|pass)\\s*[:\\-]\\s*(.+?)\\s*$",
    "Applicant Name": "(?im)^\\s*applicant\\s*name\\s*[:\\-]\\s*(.+?)\\s*$",
    "Applicant Mobile Number": "(?im)^\\s*(?:applicant\\s*)?(?:mobile|phone|contact)\\s*(?:number|no\\.?)?\\s*[:\\-]\\s*([+\\d][\\d\\s\\-()]{7,})\\s*$",
    "Engineer Name": "(?im)^\\s*engineer\\s*name\\s*[:\\-]\\s*(.+?)\\s*$",
    "Allocation Date": "(?im)^\\s*(?:allocation|allotment)\\s*date\\s*[:\\-]\\s*([^\\n\\r]+?)\\s*$"
  }
}
